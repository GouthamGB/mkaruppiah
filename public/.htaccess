DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect legacy /equipment to /products
  RewriteRule ^equipment/(.*)$ /products/$1 [R=301,L]
  RewriteRule ^equipment/?$ /products/ [R=301,L]

  # If a directory exists, ensure trailing slash for consistent URLs
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.*[^/])$ /$1/ [R=301,L]

  # If requested path without slash has an index.html in that folder, rewrite to it
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L,QSA]

  # If requested path with .html exists as a file
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L,QSA]

  # Serve 404.html if page not found
  ErrorDocument 404 /404.html
</IfModule>
